# Copy this file to .env and fill in your actual MySQL credentials

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=kartae

PORT=3000

# Email configuration
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# Alternative: Mailgun SMTP (recommended for production on Render)
MAILGUN_HOST=smtp.mailgun.org
MAILGUN_PORT=587
MAILGUN_USER=postmaster@your-domain.mailgun.org
MAILGUN_PASS=your-mailgun-smtp-password

# Optional: SendGrid API key
SENDGRID_API_KEY=your-sendgrid-api-key

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
